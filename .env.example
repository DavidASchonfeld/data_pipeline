# Local development settings for agent_data — copy to .env (gitignored) and fill in the blanks.
# docker-compose.yml and agent_data/config.py both read .env; real environment variables always win.

# Which platform profile to use: local (laptop), aws (live K3s box) or azure.
PLATFORM_PROFILE=local

# Local pgvector container from docker-compose.yml (it listens on 127.0.0.1:5433 on the laptop).
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5433
PGVECTOR_USER=pgvector
PGVECTOR_DB=pgvector
PGVECTOR_PASSWORD=

# Optional per-component overrides: uncomment one only to replace the profile's default for that component.
# (Kept commented out because genai/ also reads LLM_PROVIDER and treats a blank value as an error.)
# LAKE_URI=/absolute/path/or/s3://bucket/prefix
# SEARCH_BACKEND=pgvector
# EMBEDDER=local
# LLM_PROVIDER=anthropic
# AGENT_RUNNER=native

# SEC EDGAR (Bronze ingest): the SEC requires a real contact email in every request's User-Agent.
# EDGAR_CONTACT_EMAIL=you@example.com
# EDGAR_REQUESTS_PER_SECOND=8     # never above 10 (SEC fair-access limit)
